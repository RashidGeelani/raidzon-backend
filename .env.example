# Reference only: Spring Boot does not automatically load this file.
# Configure these values in your backend host's environment/secret settings.
# NEVER put real credentials in this file — it is committed to git.
SPRING_PROFILES_ACTIVE=postgres
RAIDZON_DATABASE_URL=jdbc:postgresql://<host>:5432/postgres
RAIDZON_DATABASE_USERNAME=<database-user>
RAIDZON_DATABASE_PASSWORD=<database-password>

# Keep disabled until account, template and secrets are ready.
RAIDZON_SMS_PROVIDER=disabled
# Enable only with demo credentials removed from the configured MSG91 widget.
RAIDZON_WIDGET_ENABLED=false
RAIDZON_MSG91_AUTH_KEY=
# The widget uses this same server AuthKey for verifyAccessToken.
# Do not substitute the widget's client-side tokenAuth here.
RAIDZON_MSG91_TEMPLATE_ID=
RAIDZON_AUTH_PEPPER=
# Comma-separated frontend origins permitted to call the API directly.
RAIDZON_CORS_ORIGINS=https://raidzon.com,https://www.raidzon.com,https://raidzon-frontend.vercel.app,http://127.0.0.1:5173

# Optional: regex of trusted proxy IPs whose X-Forwarded-For header is honoured.
# The default trusts private ranges (10.x, 172.16-31.x, 192.168.x, 100.64-127.x, 127.x),
# which covers Render's internal load balancer.
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=
